# Copy to .env on the server. Never commit .env.

# Freelancer.com official API token (required). Generate a NEW one if an old token was ever committed or shared.
FREELANCER_OAUTH_TOKEN=

# Shown in the User-Agent so site owners can contact you (email or URL). Be honest here.
SCRAPER_CONTACT=

# Pacing (optional)
SCRAPE_POLL_SECONDS=300
MIN_REQUEST_GAP_MS=3000

# Supabase: the worker writes with the SERVICE ROLE (secret) key. Server only, never in the website.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Alerts (receives instant notifications when projects match your skills)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Send every new project to Telegram, even when it doesn't meet the skill/budget match filters.
TELEGRAM_NOTIFY_ALL_NEW_PROJECTS=true
MIN_MATCH_SCORE=4
MIN_PROJECT_BUDGET=15

# AI Bid Proposal Generator (optional: uses OpenAI or Gemini if set, or smart template fallback)
# Fallback chain: OPENAI_API_KEY → GEMINI_API_KEY → GEMINI_API_KEY_2 → smart template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_API_KEY_2=       ← second Gemini key from a DIFFERENT Google account (gives +20 req/day)
# GEMINI_MODEL=gemini-3.8-flash   ← current free model (20 req/day per key, 40/day with 2 keys)

# Set to true to keep ALL projects in the DB forever (disables the 3-day auto-deletion)
# DISABLE_CLEANUP=true
