# Freelancer.com OAuth Token (required for Freelancer active projects API)
FREELANCER_OAUTH_TOKEN=OtQ8XOM3XjJT39EV347Y8sjvjwMa9m

# ── Supabase Database (required for cloud storage) ──────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ── Scraper Storage (local JSON fallback) ────────────────
LIVE_PROJECTS_FILE=data/projects.json
LIVE_SCRAPER_HOURS=12
