    "scrape": "node --experimental-strip-types cli.ts --once",
    "scrape:me": "node --experimental-strip-types cli.ts --region=middle-east --once",
    "scrape:int": "node --experimental-strip-types cli.ts --region=international --once",
    "health": "node --experimental-strip-types cli.ts --health",
    "stats": "node --experimental-strip-types cli.ts --stats",
    "test:batch2": "node --experimental-strip-types --test adapters/shoghlonline.test.ts adapters/nafezly.test.ts adapters/freelance-arabs.test.ts adapters/listing-tracker.test.ts",
