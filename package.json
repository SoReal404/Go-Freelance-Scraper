  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test net/polite-http.test.ts storage/project-store.test.ts engine.test.ts adapters/mostaql.test.ts adapters/nafezly.test.ts adapters/shoghlonline.test.ts adapters/freelance-arabs.test.ts adapters/listing-tracker.test.ts adapters/freelancer.test.ts adapters/peopleperhour.test.ts alerts/matcher.test.ts",
